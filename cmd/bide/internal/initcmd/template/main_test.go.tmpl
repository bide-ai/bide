// TestMain lets the test binary run the program itself, for TestCrashAndRecover.
func TestMain(m *testing.M) {
	if os.Getenv("SCAFFOLD_RUN_MAIN") == "1" {
		main()
		os.Exit(0)
	}
	os.Exit(m.Run())
}

// TestStory: the run pauses at the gate, two approvers sign, the refund runs once, a second run
// repeats nothing, and the evidence verifies: 2 of 3 approvers signed this exact refund.
func TestStory(t *testing.T) {
	dir := t.TempDir()
	ctx := context.Background()
	for range 2 {
		if err := story(ctx, dir, model()); err != nil {
			t.Fatal(err)
		}
	}
	if n := (provider{dir: dir}).refunds(); n != 1 {
		t.Fatalf("the provider holds %d refunds, want exactly 1", n)
	}
	k, err := loadKeys(dir)
	if err != nil {
		t.Fatal(err)
	}
	b, err := os.ReadFile(filepath.Join(dir, "evidence.json"))
	if err != nil {
		t.Fatal(err)
	}
	var pkg audit.EvidencePackage
	if err := json.Unmarshal(b, &pkg); err != nil {
		t.Fatal(err)
	}
	policy := agent.ApprovalPolicy{Need: 2, Approvers: approvers}
	v, err := audit.VerifyApprovals(pkg.Actions, gateKey, policy, k.verifiers(), audit.Ed25519Verifier{Pub: k["log"].Public().(ed25519.PublicKey)})
	if err != nil || !v.OK {
		t.Fatalf("the approvals do not verify: %v %v", err, v.Problems)
	}
}

// TestCrashAndRecover: the process dies inside notify, after the refund's result is journaled (exit
// status 3). The next start recovers the interrupted run: it completes, and the provider holds
// exactly one refund. This is BIDE_CRASH=notify go run . followed by go run .
func TestCrashAndRecover(t *testing.T) {
	dir := t.TempDir()
	run := func(env ...string) (int, string) {
		cmd := exec.Command(os.Args[0], "-test.run=^$")
		cmd.Dir = dir
		cmd.Env = append(append(os.Environ(), "SCAFFOLD_RUN_MAIN=1"), env...)
		out, err := cmd.CombinedOutput()
		var exit *exec.ExitError
		if errors.As(err, &exit) {
			return exit.ExitCode(), string(out)
		}
		if err != nil {
			t.Fatal(err)
		}
		return 0, string(out)
	}
	if code, out := run("BIDE_CRASH=notify"); code != 3 || !strings.Contains(out, "crash:") {
		t.Fatalf("the crashing run exited %d, want 3:\n%s", code, out)
	}
	if n := (provider{dir: dir}).refunds(); n != 1 {
		t.Fatalf("after the crash the provider holds %d refunds, want 1 (the refund ran before notify)", n)
	}
	code, out := run()
	if code != 0 || !strings.Contains(out, "recovered 1 interrupted run") || !strings.Contains(out, "done:") {
		t.Fatalf("the restart exited %d, want 0 having recovered the run and finished:\n%s", code, out)
	}
	if n := (provider{dir: dir}).refunds(); n != 1 {
		t.Fatalf("after recovery the provider holds %d refunds, want exactly 1", n)
	}
}

// TestRealModelShapedReplies runs the story on model/openai against a fake OpenAI-compatible
// provider that answers as a real model did when asked for JSON in the prompt only: in a code
// fence, with the order id as a number. Unless the request carries a strict json_schema
// response format for Refund, the provider answers that way. The run finishes on the first try,
// with one model call and one refund.
func TestRealModelShapedReplies(t *testing.T) {
	calls := 0
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		calls++
		body, _ := io.ReadAll(r.Body)
		var req struct {
			ResponseFormat struct {
				Type       string `json:"type"`
				JSONSchema struct {
					Strict bool `json:"strict"`
					Schema struct {
						Properties map[string]struct {
							Type string `json:"type"`
						} `json:"properties"`
					} `json:"schema"`
				} `json:"json_schema"`
			} `json:"response_format"`
		}
		_ = json.Unmarshal(body, &req)
		rf, props := req.ResponseFormat, req.ResponseFormat.JSONSchema.Schema.Properties
		reply := "```json\n{\"order\": 42, \"amount\": 120, \"reason\": \"arrived damaged\"}\n```"
		if rf.Type == "json_schema" && rf.JSONSchema.Strict && props["order"].Type == "string" && props["amount"].Type == "integer" {
			reply = `{"order": "order-42", "amount": 120, "reason": "arrived damaged"}`
		}
		chunk, _ := json.Marshal(map[string]any{"choices": []any{map[string]any{"delta": map[string]string{"content": reply}, "finish_reason": "stop"}}})
		w.Header().Set("Content-Type", "text/event-stream")
		fmt.Fprintf(w, "data: %s\n\ndata: [DONE]\n\n", chunk)
	}))
	defer srv.Close()

	dir := t.TempDir()
	m := openai.New("test-key", openai.WithBaseURL(srv.URL), openai.WithModel("gpt-4o-mini"))
	if err := story(context.Background(), dir, m); err != nil {
		t.Fatalf("the run on a real-model-shaped provider: %v", err)
	}
	if calls != 1 {
		t.Fatalf("the provider was called %d times, want 1", calls)
	}
	if n := (provider{dir: dir}).refunds(); n != 1 {
		t.Fatalf("the provider holds %d refunds, want exactly 1", n)
	}
}
