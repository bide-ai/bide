// Command __NAME__ is a bide plan flow, scaffolded by bide init. It refunds an order:
//
//	assess (a model call) -> refund (a side effect, gated 2 of 3) -> notify
//
// flow.yaml declares the flow; this file registers a block for each node. go run . first resumes
// any run a crash interrupted (agent.Recover), then drives the run in run.db: it pauses at the
// refund until two approvers sign, records two signed approvals, resumes, refunds once, and writes
// evidence.json and approver-keys.json for an auditor. Run it again and nothing runs twice.
// BIDE_CRASH=notify go run . kills the process mid-run, to try the recovery. See README.md.
package main

import (
	"context"
	"crypto/ed25519"
	"crypto/rand"
	_ "embed"
	"encoding/hex"
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"strings"
	"time"

	"github.com/bide-ai/bide/agent"
	"github.com/bide-ai/bide/agent/agenttest"
	"github.com/bide-ai/bide/audit"
	// "github.com/bide-ai/bide/model/openai" // uncomment with the real model in model()
	"github.com/bide-ai/bide/plan"
	"github.com/bide-ai/bide/store/sqlite"
	"go.yaml.in/yaml/v3"
)

//go:embed flow.yaml
var flowYAML []byte

const (
	runID   = "refund-order-42"
	gateKey = "node:refund" // the gated node's key: what approvers sign, and the call bide audit checks
)

// approvers are the gate's approvers, as flow.yaml declares them.
var approvers = []string{"ops", "finance", "risk"}

// Order is the flow's input, Refund the model's proposal (and what approvers sign), Receipt the
// flow's output.
type Order struct {
	ID     string `json:"id"`
	Amount int    `json:"amount"`
	Note   string `json:"note"`
}

type Refund struct {
	Order  string `json:"order"`
	Amount int    `json:"amount"`
	Reason string `json:"reason"`
}

type Receipt struct {
	Order  string `json:"order"`
	Amount int    `json:"amount"`
	Note   string `json:"note"`
}

// model is the model the assess node calls. By default it is scripted, so the flow runs with no
// API key and no network. A real model that supports structured output (model/openai,
// model/gemini) is sent the Refund type's JSON schema, so it answers with that JSON and nothing
// else; the prompt in register also spells the fields out, for a model that does not.
func model() agent.Model {
	// ---- To use a real model -------------------------------------------------------------------
	// Set OPENROUTER_API_KEY (or OPENAI_API_KEY) and uncomment these lines and the openai import
	// above, then start over (see README.md: the journal holds the scripted model's answer). Any
	// OpenAI-compatible endpoint works through WithBaseURL (Ollama, vLLM, Groq, ...);
	// model/anthropic and model/gemini are the native adapters.
	//
	// if key := os.Getenv("OPENROUTER_API_KEY"); key != "" {
	// 	return openai.New(key, openai.WithBaseURL("https://openrouter.ai/api/v1"), openai.WithModel("openai/gpt-4o-mini"))
	// }
	// if key := os.Getenv("OPENAI_API_KEY"); key != "" {
	// 	return openai.New(key, openai.WithModel("gpt-4o-mini"))
	// }
	// ---------------------------------------------------------------------------------------------
	return agenttest.NewScriptedModel(agenttest.TextTurn(`{"order": "order-42", "amount": 120, "reason": "arrived damaged"}`))
}

// provider stands in for a payment provider: each refund is a line in refunds.log.
type provider struct{ dir string }

func (p provider) refund(r Refund) error {
	f, err := os.OpenFile(filepath.Join(p.dir, "refunds.log"), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
	if err != nil {
		return err
	}
	defer f.Close()
	_, err = fmt.Fprintf(f, "refunded %d on %s (%s)\n", r.Amount, r.Order, r.Reason)
	return err
}

// refunds counts the refunds the provider holds.
func (p provider) refunds() int {
	b, err := os.ReadFile(filepath.Join(p.dir, "refunds.log"))
	if err != nil {
		return 0
	}
	return strings.Count(string(b), "\n")
}

// register registers a block for each node flow.yaml declares.
func register(p provider) (*plan.Registry, error) {
	reg := plan.NewRegistry()
	return reg, errors.Join(
		reg.RegisterModel[Order, Refund]("assess",
			`Order {{.ID}} for {{.Amount}} dollars: {{.Note}}. Propose a refund as a JSON object with "order" (the string "{{.ID}}"), "amount" (an integer number of dollars) and "reason" (a short string). Answer with the JSON object only.`),
		// The default Safety: a side effect. bide runs it at most once, and if the process dies
		// after it starts and before its result is journaled, the run halts instead of refunding
		// again (resolve it with agent.ResolveHalt).
		reg.RegisterStep("refund", func(_ context.Context, r Refund) (Refund, error) {
			return r, p.refund(r)
		}),
		reg.RegisterStep("notify", func(_ context.Context, r Refund) (Receipt, error) {
			crashIf("notify") // after the refund's result is journaled: try recovery with BIDE_CRASH=notify
			return Receipt{Order: r.Order, Amount: r.Amount, Note: "refunded: " + r.Reason}, nil
		}, plan.ReadOnly()), // no side effect: safe to run again on resume
	)
}

// load loads flow.yaml against the registry, with model m and the approvers' keys bound.
func load(p provider, k keys, m agent.Model) (*plan.Flow[Order, Receipt], error) {
	reg, err := register(p)
	if err != nil {
		return nil, err
	}
	config, err := yamlToJSON(flowYAML)
	if err != nil {
		return nil, err
	}
	return plan.Load[Order, Receipt](config, reg, plan.WithLoadedModel(m), plan.WithLoadedApproverVerifiers(k.verifiers()))
}

func main() {
	if err := story(context.Background(), ".", model()); err != nil {
		fmt.Fprintln(os.Stderr, tag(colorErr, "1;31", "✗", "error:"), err)
		os.Exit(1)
	}
}

// story drives the run in dir from wherever it is, with model m: it pauses at the gate, two
// approvers sign, the run resumes and refunds once, and the evidence is written. A run that
// already finished is read back from the journal, and nothing runs twice.
func story(ctx context.Context, dir string, m agent.Model) error {
	k, err := loadKeys(dir)
	if err != nil {
		return err
	}
	p := provider{dir: dir}
	flow, err := load(p, k, m)
	if err != nil {
		return err
	}
	store, err := sqlite.Open(filepath.Join(dir, "run.db"))
	if err != nil {
		return err
	}
	defer store.Close()
	j, err := agent.NewJournal(store)
	if err != nil {
		return err
	}
	// Recovery. A process can die mid-run: a deploy, an OOM kill, a crash. agent.Recover finds every
	// run in the journal that started and did not finish, and drives it again from its journal:
	// steps already recorded are not repeated, so the refund, a side effect, still happens at most
	// once, and a refund cut off mid-call halts with agent.OutcomeUnknown instead of running twice.
	// A run waiting at its gate stays paused. One pass at startup suits a program that runs and
	// exits; a long-running service runs agent.RecoverLoop instead, which also picks up runs whose
	// process died elsewhere (a per-run lease keeps two processes from driving one run).
	if n, err := agent.Recover(ctx, j, resumeFlow(flow, j)); err != nil {
		return err
	} else if n > 0 {
		fmt.Printf("%s %d interrupted run(s)\n", tag(colorOut, "34", "✓", "recovered"), n)
	}

	in := Order{ID: "order-42", Amount: 120, Note: "the parcel arrived damaged"}
	for range 3 {
		out, err := flow.Run(ctx, j, runID, in)
		var pend *agent.ApprovalPending
		switch {
		case errors.As(err, &pend):
			q := pend.Quorum
			fmt.Printf("%s before %s: %d of %d approvals (pending %s)\n", tag(colorOut, "33", "!", "paused"), pend.ToolUseID, q.Approved, q.Need, strings.Join(q.Pending, ", "))
			if err := approve(ctx, j, k, q.Pending[0]); err != nil {
				return err
			}
			continue
		case err != nil:
			return err
		}
		fmt.Printf("%s %s (%d)\nrefunds the provider holds: %d\n", tag(colorOut, "32", "✓", "done:"), out.Note, out.Amount, p.refunds())
		return writeEvidence(ctx, j, k, dir)
	}
	return errors.New("the run did not finish")
}

// resumeFlow is the agent.Resumer for this program's runs: given a run Recover found unfinished,
// it reads the run's input from its journaled start and drives the flow again. A run of another
// kind is not this program's (agent.ErrNotResumable), and Recover leaves it alone.
func resumeFlow(flow *plan.Flow[Order, Receipt], j *agent.Journal) agent.Resumer {
	return func(ctx context.Context, runID string, start agent.RunStart) error {
		if start.Kind != agent.RunKindFlow || start.Flow == nil || start.Flow.Name != "refund" {
			return fmt.Errorf("run %s is not a refund flow: %w", runID, agent.ErrNotResumable)
		}
		var in Order
		if err := json.Unmarshal([]byte(start.Input.Text()), &in); err != nil {
			return fmt.Errorf("run %s: its input: %w", runID, err)
		}
		_, err := flow.Run(ctx, j, runID, in)
		return err
	}
}

// crashIf kills the process inside step when BIDE_CRASH names it, the first time only (a marker
// file records that it crashed), so you can watch the next run recover: BIDE_CRASH=notify go run .
// then go run . again.
func crashIf(step string) {
	if os.Getenv("BIDE_CRASH") != step {
		return
	}
	marker := ".crashed-" + step
	if _, err := os.Stat(marker); err == nil {
		return
	}
	_ = os.WriteFile(marker, nil, 0o644)
	fmt.Printf("%s the process dies inside %s (BIDE_CRASH=%s)\n", tag(colorOut, "1;31", "✗", "crash:"), step, step)
	os.Exit(3)
}

// approve signs the recorded request (the node and its input) as approver id and records it.
func approve(ctx context.Context, j *agent.Journal, k keys, id string) error {
	recs, err := j.History(ctx, runID)
	if err != nil {
		return err
	}
	_, call, ok := agent.FindToolCall(recs, gateKey)
	if !ok {
		return errors.New("the run has not reached the gate")
	}
	subject := agent.ApprovalSubject{RunID: runID, ToolUseID: gateKey, ToolName: call.Name, Args: call.Args}
	sig := ed25519.Sign(k[id], agent.ApprovalDecisionBytes(subject, id, true))
	d := agent.Decision{RunID: runID, ToolUseID: gateKey, ApproverID: id, Approved: true, Alg: audit.AlgEd25519, Signature: sig}
	if err := agent.SubmitDecision(ctx, j, d, agent.WithDecisionCheck(k.verifiers())); err != nil {
		return err
	}
	fmt.Printf("%s %s\n", tag(colorOut, "32", "✓", id+" approved"), call.Args)
	return nil
}

// writeEvidence writes evidence.json (the run's proofs and the gate's decisions, sealed with the log
// key) and approver-keys.json (each approver's public key), the inputs of bide audit and bide view.
func writeEvidence(ctx context.Context, j *agent.Journal, k keys, dir string) error {
	logKey := audit.Ed25519Signer{Priv: k["log"]}
	pkg, err := audit.Evidence(ctx, j, runID, logKey, time.Now().UnixNano())
	if err != nil {
		return err
	}
	acts, err := audit.ApprovalEvidence(ctx, j, runID, gateKey, pkg.STH)
	if err != nil {
		return err
	}
	pkg.Actions = append(pkg.Actions, acts...)
	if err := pkg.Seal(logKey); err != nil {
		return err
	}
	pub := map[string]string{}
	for _, id := range approvers {
		pub[id] = k.public(id)
	}
	if err := writeJSON(filepath.Join(dir, "evidence.json"), pkg); err != nil {
		return err
	}
	if err := writeJSON(filepath.Join(dir, "approver-keys.json"), pub); err != nil {
		return err
	}
	if err := os.WriteFile(filepath.Join(dir, "keys", "log.pub"), []byte(k.public("log")+"\n"), 0o644); err != nil {
		return err
	}
	fmt.Printf("%s evidence.json, approver-keys.json and keys/log.pub\n", tag(colorOut, "32", "✓", "wrote"))
	return nil
}

// keys are the private keys of the log operator ("log") and each approver, generated on the first
// run into keys/keys.json. Real approvers each hold their own key; one file is for the scaffold.
type keys map[string]ed25519.PrivateKey

func loadKeys(dir string) (keys, error) {
	path := filepath.Join(dir, "keys", "keys.json")
	seeds := map[string]string{}
	b, err := os.ReadFile(path)
	switch {
	case errors.Is(err, os.ErrNotExist):
		for _, id := range append([]string{"log"}, approvers...) {
			seed := make([]byte, ed25519.SeedSize)
			if _, err := rand.Read(seed); err != nil {
				return nil, err
			}
			seeds[id] = hex.EncodeToString(seed)
		}
		if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
			return nil, err
		}
		if err := writeJSON(path, seeds); err != nil {
			return nil, err
		}
	case err != nil:
		return nil, err
	default:
		if err := json.Unmarshal(b, &seeds); err != nil {
			return nil, err
		}
	}
	k := keys{}
	for id, s := range seeds {
		seed, err := hex.DecodeString(s)
		if err != nil || len(seed) != ed25519.SeedSize {
			return nil, fmt.Errorf("%s: key %q is not a hex ed25519 seed", path, id)
		}
		k[id] = ed25519.NewKeyFromSeed(seed)
	}
	return k, nil
}

func (k keys) public(id string) string {
	return "ed25519:" + hex.EncodeToString(k[id].Public().(ed25519.PublicKey))
}

// verifiers resolves an approver id to its public key, for the gate and the decision check.
func (k keys) verifiers() agent.ApproverVerifierFor {
	return func(id string) (agent.ApproverVerifier, bool) {
		if id == "log" || k[id] == nil {
			return nil, false
		}
		return audit.Ed25519Verifier{Pub: k[id].Public().(ed25519.PublicKey)}, true
	}
}

func writeJSON(path string, v any) error {
	b, err := json.MarshalIndent(v, "", "  ")
	if err != nil {
		return err
	}
	return os.WriteFile(path, append(b, '\n'), 0o600)
}

// yamlToJSON converts flow.yaml to the JSON plan.Load reads.
func yamlToJSON(data []byte) ([]byte, error) {
	var v any
	if err := yaml.Unmarshal(data, &v); err != nil {
		return nil, err
	}
	return json.Marshal(v)
}
