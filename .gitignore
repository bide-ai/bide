# Compiled binaries / plugins
*.exe
*.dll
*.so
*.dylib

# Test binaries, coverage, profiles
*.test
*.out
# coverage output only (not the coverage workflow, script or config)
/coverage.out
/coverage.txt
/coverage.html
*.coverprofile

# Local test artifacts (temp SQLite event logs, etc.)
*.db
*.db-journal
*.db-wal
*.db-shm

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/

# compiled cmd/bench binary
/bench

# compiled bide binary (go build ./cmd/bide from the root)
/bide
# a command built in its own directory (go build . in cmd/<name>), as cmd/bide-demo/bide-demo once was
/cmd/*/bide
/cmd/*/bide-*

# compiled example binaries (from `go build .` in an example dir)
examples/mcp/mcp
examples/observability/observability
examples/plan/plan
examples/approval/approval
examples/approval/evidence.json
examples/approval/approver-keys.json

# internal strategy/positioning docs (not published). Only those are ignored: every Go package
# under internal/ is tracked, so a new package needs no entry here.
/internal/*.md
/internal/design/

# a journal file written by v0.7.0, the fixture of store/sqlite's legacy-file test
!/store/sqlite/testdata/v070.db
