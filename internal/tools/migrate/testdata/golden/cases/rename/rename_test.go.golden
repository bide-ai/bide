package rename

import (
	"testing"

	"github.com/bide-ai/bide/agent/agenttest"
	"github.com/bide-ai/bide/mcptools"
)

func TestRename(t *testing.T) {
	m := agenttest.NewScriptedModel(agenttest.ToolTurn("c1", "x", `{}`), agenttest.TextTurn("done"))
	var _ *agenttest.ScriptedModel = m
	_ = mcptools.Connect()
}
