// Command mainprog is a program built on the old API: errors are handled as main handles them.
package main

import (
	"context"
	"fmt"
	"log"

	"github.com/bide-ai/bide/agent"
	"github.com/bide-ai/bide/agent/agenttest"
)

func main() {
	ctx := context.Background()
	store, err := agent.NewJournal(agent.NewMemStore())
	if err != nil {
		log.Fatal(err)
	}
	a, err := agent.New(agenttest.NewScriptedModel(agenttest.TextTurn("hi")), store, agent.WithMaxTurns(5))
	if err != nil {
		log.Fatal(err)
	}
	res, err := a.Run(ctx, "r1", agent.UserText("hello"))
	if err != nil {
		fmt.Println(err)
		return
	}
	out := res.Message
	fmt.Println(out.Text())
	fmt.Println(answer(ctx, a))
}

func answer(ctx context.Context, a *agent.Agent) (agent.Message, error) {
	res, err := a.Run(ctx, "r2", agent.UserText("book it"), agent.WithSaga())
	if err != nil {
		return agent.Message{}, err
	}
	return res.Message, nil
}

func build(m agent.Model) (*agent.Agent, error) {
	j, err := agent.NewJournal(agent.NewMemStore())
	if err != nil {
		return nil, err
	}
	ag, err := agent.New(m, j)
	if err != nil {
		return nil, err
	}
	sub := agent.MustSubAgent("helper", "helps", ag)
	j2, err := agent.NewJournal(agent.NewMemStore())
	if err != nil {
		return nil, err
	}
	ag2, err := agent.New(m, j2, agent.WithTools(sub))
	if err != nil {
		return nil, err
	}
	return ag2, nil
}
