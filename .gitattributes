# Go sources the tools rewrite or scan, kept with LF line endings on every platform, so a
# golden file compares byte for byte with what the tool writes (gofmt writes LF).
internal/tools/oldnames/testdata/** text eol=lf

# Golden files compare byte for byte with what a test writes (LF) on every platform.
**/testdata/*.golden text eol=lf
# plan's list of the messages that fall in the "other" finding kind is compared byte for byte.
plan/testdata/*.txt text eol=lf

# Attestation test data is byte-exact: the attestations are signed binary, and the PEM and JSON
# files are compared and parsed as written. No line-ending conversion on any platform.
signer/gcpkms/testdata/attestation/** -text
signer/gcpkms/testdata/attestation/*.gz binary

# The approve page's sources and the canonical-arguments vectors are byte-exact: the page bundle is
# built from the embedded bytes and published with their hashes, and the vectors are compared with
# what Go writes (LF), as is the golden list of the bundle's hashes. No line-ending conversion on any platform.
approvals/page/** text eol=lf
approvals/testdata/approve-page.SHA256SUMS text eol=lf
agent/testdata/canonical_args_vectors.json text eol=lf

# RFC 3161 vectors are signed DER and PEM, and the fuzz corpus holds exact bytes: byte-exact on every platform.
audit/rfc3161/testdata/** -text

# Conformance captures from real CAs: LF on every platform (the AD CS tools write CRLF).
audit/testdata/ejbca/** text eol=lf
audit/testdata/adcs/** text eol=lf

# The ISO 4217 list is kept exactly as SIX publishes it (CRLF), so its SHA-256 in internal/amount/iso4217.go is the file's.
internal/amount/testdata/iso4217-list-one.xml -text

# The journal golden of the effective-gate refactor is compared byte for byte.
agent/testdata/effective_gates_golden.json text eol=lf
agent/testdata/untrusted_marks_golden.jsonl text eol=lf

# The declarations golden is compared byte for byte with what Declarations writes (LF) on every platform.
internal/declarations/testdata/*.json text eol=lf
